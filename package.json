{
  "name": "habit-tracker",
  "version": "0.1.0",
  "description": "Personal Habit Tracker - hourly break reminders, water reminders, and habit stats",
  "main": "./out/main/index.js",
  "author": "Akram Hoshen",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.cjs",
    "dist:win": "npm run icons && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.akramhoshen.habittracker",
    "productName": "Habit Tracker",
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "copyright": "Copyright © 2026 Akram Hoshen",
    "electronDist": "node_modules/electron/dist"
  }
}
